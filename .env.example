# Copy this file to .env and fill in at least one key.
# With no keys the app runs in demo mode (no AI, it just quotes the best passages).

# Which model answers: auto | claude | gemini | demo
# "auto" uses Claude if its key is set, otherwise Gemini, otherwise demo mode.
LLM_PROVIDER=auto

# Claude (Anthropic) - https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Google Gemini (has a free tier) - https://aistudio.google.com/apikey
# A Gemini key also turns on semantic (hybrid) search, even when Claude writes the answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional tuning
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=20
